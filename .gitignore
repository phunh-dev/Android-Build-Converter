# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  build artifacts only — the .spec file IS checked in (it declares the bundled jar)
*.manifest

# Virtual environments
venv/
.venv/
env/
ENV/

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editors / IDEs
.vscode/
.idea/
*.swp
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# App-generated conversion artifacts (in case anyone converts inside the repo)
*_output/
*.apks
*.apk
*.aab

# Keystores — never commit signing material
*.jks
*.keystore
*.p12

# NOTE: resources/bundletool.jar is intentionally NOT ignored — it ships with the app.
